# ---------- Database (WSL Postgres: use 127.0.0.1, NOT localhost) ----------
DATABASE_URL="postgresql://postgres:paca_dev@127.0.0.1:5432/paca_dev?schema=public"

# ---------- Redis (queues, rate limiting, exam timers) ----------
REDIS_URL="redis://127.0.0.1:6379"

# ---------- Virus scanning (clamd) ----------
# Optional. Unset = uploads are type-checked but stored as PENDING ("Not scanned").
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT=3310

# ---------- API ----------
API_PORT=4000
API_PUBLIC_URL="http://127.0.0.1:4000"
WEB_PUBLIC_URL="http://127.0.0.1:3000"
NODE_ENV="development"

# ---------- Auth ----------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
COOKIE_DOMAIN="127.0.0.1"

# ---------- Paystack ----------
# Only the secret key is needed: the checkout popup is opened with a per-transaction
# access code from the API, and webhooks are authenticated by HMAC signature.
PAYSTACK_SECRET_KEY=""
PAYSTACK_CURRENCY="GHS"          # the account is Ghanaian; mobile money requires GHS
PAYSTACK_USD_RATE=12.5           # cedis per USD (tier prices are stored in USD)
PAYSTACK_CHANNELS="card,mobile_money,bank,bank_transfer"

# ---------- Email (Brevo) ----------
# Sends the 6-digit email verification code. Use EITHER Brevo SMTP (brevo.com >
# SMTP & API > SMTP; port 2525 works on DigitalOcean) OR a Brevo API key.
# MAIL_FROM_EMAIL (or SMTP_FROM) must be a sender verified in Brevo.
# Leave both blank locally: codes are then printed in the API log.
SMTP_HOST=""
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="PACA"

# ---------- Object storage (Cloudflare R2 / S3-compatible) ----------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="paca-private"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Email ----------
RESEND_API_KEY=""
MAIL_FROM="PACA <no-reply@pac-a.org>"

# ---------- AI (question drafting + job classification) ----------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# --- SEO, analytics and Google indexing (production: set in .env.production) ---
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = no analytics.
# Loaded only after a visitor accepts analytics cookies.
GA_MEASUREMENT_ID=""
# Google Search Console HTML-tag verification code (the content="..." value only).
GOOGLE_SITE_VERIFICATION=""
