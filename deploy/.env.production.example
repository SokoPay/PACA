# Copy to .env.production at the repo root on the droplet and fill in.
# Never commit the filled-in file (.gitignore already excludes .env.*).

# The URL people type into the browser — no trailing slash.
#   With a domain:   https://paca-test.example.com
#   IP only:         http://203.0.113.10
PUBLIC_URL="http://YOUR_DROPLET_IP"

# ---------- Where PACA listens ----------
# SHARED droplet (other sites already use ports 80/443 through a host Caddy/nginx):
# PACA listens only on loopback; the host web server forwards PACA's domain to it and
# handles HTTPS (deploy/host-caddy-paca.caddy or deploy/nginx-paca.conf).
# PUBLIC_URL is then https://<your domain>.
SITE_ADDRESS=":80"
HTTP_BIND="127.0.0.1:8090"
HTTPS_BIND="127.0.0.1:8453"
#
# DEDICATED droplet (nothing else on 80/443): delete HTTP_BIND/HTTPS_BIND above
# and set SITE_ADDRESS to your domain (paca-test.example.com) — Caddy then gets
# the HTTPS certificate itself. Its DNS A record must already point here.

# Generate each with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=""

# Generate each with: openssl rand -base64 48 — the two must differ.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ---------- Paystack ----------
# Secret key from Paystack Dashboard > Settings > API Keys & Webhooks.
# sk_test_... for the test droplet (no real money moves); sk_live_... only for real launch.
PAYSTACK_SECRET_KEY=""
# Charge currency. The PACA Paystack account is Ghanaian, so GHS (required for mobile money).
PAYSTACK_CURRENCY="GHS"
# Cedis per 1 USD — tier prices are stored in USD and converted at this rate.
PAYSTACK_USD_RATE="12.5"
# Methods offered in the checkout popup.
PAYSTACK_CHANNELS="card,mobile_money,bank,bank_transfer"
# Then set the webhook URL in the Paystack dashboard to:
#   ${PUBLIC_URL}/api/v1/payments/paystack/webhook

# ---------- Email (Brevo) ----------
# Sends the 6-digit email verification code. Use EITHER Brevo SMTP (brevo.com >
# SMTP & API > SMTP; port 2525 works on DigitalOcean) OR a Brevo API key.
# MAIL_FROM_EMAIL (or SMTP_FROM) must be a sender verified in Brevo.
# Leave both blank locally: codes are then printed in the API log.
SMTP_HOST=""
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="PACA"

# Optional — leave blank until you have a key.
ANTHROPIC_API_KEY=""
