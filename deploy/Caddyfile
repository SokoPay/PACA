{$SITE_ADDRESS} {
	encode gzip

	# Application documents are capped at 8MB by the API; leave headroom for multipart.
	request_body {
		max_size 10MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy api:4100
	}

	handle {
		reverse_proxy web:3100
	}
}
