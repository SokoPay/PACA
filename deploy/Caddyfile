{
	servers {
		# When a host nginx sits in front (shared droplet), it reaches Caddy from a
		# private Docker address. Trust the X-Forwarded-For it sends, so the API's
		# per-IP rate limits see real visitors instead of one shared nginx address.
		# Internet clients never come from private ranges, so they cannot spoof it.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode gzip

	# Application documents are capped at 8MB by the API; leave headroom for multipart.
	request_body {
		max_size 10MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy api:4100
	}

	handle {
		reverse_proxy web:3100
	}
}
